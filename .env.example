BRIDGE_API_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DOCKER_ID=your-docker-id
DOCKER_PAT=replace-with-cloud-sandboxes-enabled-pat
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
PROJECTS_FILE=./projects.json
MOCK_DOCKER=0

# Optional. Variables referenced from projects.json (names are examples; values are placeholders):
# GH_CLONE_TOKEN=replace-with-read-only-repo-token
# GH_STATUS_TOKEN=replace-with-commit-status-write-token
# NPM_TOKEN=replace-with-token-you-want-tasks-to-forward
# CI_HOOK_SECRET=replace-with-webhook-hmac-secret
# Repo hosts allowed in projects.json (replaces the default list):
# ALLOWED_GIT_HOSTS=github.com,gitlab.com
# Artifact export caps (bytes / counts):
# ARTIFACT_MAX_FILES=20
# ARTIFACT_MAX_FILE_BYTES=5242880
# ARTIFACT_MAX_TOTAL_BYTES=20971520
# ARTIFACT_INLINE_MAX_BYTES=262144
